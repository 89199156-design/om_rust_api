* text=auto

# Linux production entry points must remain directly executable after a
# checkout on Windows development hosts.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf

# Keep source/config files deterministic across Windows and Linux builders.
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
